# Public site origin. Set this at BUILD TIME and runtime on your external host.
# Replace this example domain with your actual HTTPS domain before deploying.
NEXT_PUBLIC_SITE_URL=https://vault.example.com

# Project Settings → API / API Keys. These configure the Next.js SERVER.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional additional operator POST password; a Supabase staff role is always required.
VAULT_OPERATOR_PASSWORD=
